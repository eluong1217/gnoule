{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "gnoule",
    "compatibility_date": "2026-07-28",
    "main": ".svelte-kit/cloudflare/_worker.js",
    "assets": {
        "binding": "ASSETS",
        "directory": ".svelte-kit/cloudflare"
    },
    "compatibility_flags": ["nodejs_compat"],
    "observability": {
        "enabled": true
    }
}